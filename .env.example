# Copy to .env and fill in. .env is git-ignored.

# Task 2: MCP gateway
GATEWAY_JWT_SECRET=replace-with-at-least-32-random-bytes
DOWNSTREAM_MCP_URL=http://127.0.0.1:9001/mcp

# Task 3: LLM gateway
LLM_PROVIDER_URL=http://127.0.0.1:9101/v1/chat/completions
LLM_PROVIDER_API_KEY=replace-me

# Task 4: model router
PRIMARY_URL=http://127.0.0.1:9201/v1/chat/completions
PRIMARY_API_KEY=replace-me
PRIMARY_MODEL=
SECONDARY_URL=http://127.0.0.1:9202/v1/chat/completions
SECONDARY_API_KEY=replace-me
SECONDARY_MODEL=backup-model
SECONDARY_TIMEOUT=10
TOKENS_PER_MINUTE=50000
TENANT_API_KEYS=tenant-a,tenant-b
ROUTER_DB_PATH=router.db
